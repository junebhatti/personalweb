---
import Base from '../layouts/Base.astro';
import VocabComposer from '../components/VocabComposer.astro';

// WordThru's dictionary list (DictionaryWordListView), on the web. Unlisted:
// nothing links here. Anyone with the link can read; the + only appears on a
// device that has been unlocked with the passphrase (see VocabComposer).
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const configured = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY);
---

<Base
  title="English Vocabulary"
  noindex
  appTitle="Vocab"
  standalone
  statusBar="default"
  themeColor="#f2ede0"
  manifest="/vocab.webmanifest"
>
  <div class="wt-list-page">
    <div class="wt-top">
      <span class="wt-top-side"></span>
      <h1 class="wt-top-title">English Vocabulary</h1>
      <button type="button" class="wt-top-side wt-plus" data-plus aria-label="Add a card" hidden>+</button>
    </div>

    <div class="wt-empty" data-status>
      {configured ? '' : 'Not configured. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY.'}
    </div>
    <div class="wt-words" data-list></div>
  </div>

  <VocabComposer />

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, configured }}>
    if (configured) {
      const list = document.querySelector('[data-list]');
      const status = document.querySelector('[data-status]');
      const plus = document.querySelector('[data-plus]');
      const composer = document.querySelector('[data-wt-composer]');
      let words = [];

      function row(word) {
        const item = document.createElement('div');
        item.className = 'wt-word';
        const term = document.createElement('div');
        term.className = 'wt-term';
        term.textContent = word.term;
        item.append(term);
        // WordThru shows nothing under the term when there is no meaning.
        if (word.meaning.trim()) {
          const meaning = document.createElement('div');
          meaning.className = 'wt-meaning';
          meaning.textContent = word.meaning.trim();
          item.append(meaning);
        }
        return item;
      }

      function render() {
        list.replaceChildren(...words.map(row));
        status.textContent = words.length ? '' : 'No words yet.';
      }

      async function load() {
        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/vocab?select=term,meaning&order=term.asc`, {
            headers: { apikey: SUPABASE_ANON_KEY, authorization: `Bearer ${SUPABASE_ANON_KEY}` },
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}: ${await res.text()}`);
          const rows = await res.json();
          if (!Array.isArray(rows)) throw new Error('Response is not a list');
          words = rows.filter((r) => typeof r.term === 'string' && typeof r.meaning === 'string');
          render();
        } catch (e) {
          console.error('Loading vocab failed', e);
          status.textContent = 'Couldn’t load words. Try again in a minute.';
        }
      }

      let unlocked = false;
      try {
        unlocked = Boolean(localStorage.getItem('vocab-passphrase'));
      } catch (e) {
        console.error('localStorage read failed', e);
      }
      plus.hidden = !unlocked;
      plus.addEventListener('click', () => (composer.hidden = false));
      document.addEventListener('wt-cancel', () => (composer.hidden = true));
      document.addEventListener('wt-added', (event) => {
        words.push(event.detail);
        words.sort((a, b) => a.term.localeCompare(b.term, undefined, { sensitivity: 'base' }));
        render();
      });

      load();
    }
  </script>
</Base>

<style>
  /* WordThru palette and DictionaryWordListView metrics (ContentView.swift). */
  .wt-list-page {
    --shell: #f2ede0;
    --ink: #171412;

    min-height: 100vh;
    min-height: 100dvh;
    background: var(--shell);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, system-ui, 'Helvetica Neue', Arial, sans-serif;
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }
  :global(body):has(.wt-list-page) {
    background: #f2ede0;
  }
  .wt-top,
  .wt-words,
  .wt-empty {
    max-width: 640px;
    margin: 0 auto;
  }
  .wt-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 18px 12px;
  }
  .wt-top-side {
    width: 32px;
    height: 32px;
  }
  /* Hidden on locked devices, but still holding its slot so the title stays centred. */
  .wt-plus[hidden] {
    display: block !important;
    visibility: hidden;
  }
  .wt-top-title {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
  }
  .wt-plus {
    font: inherit;
    font-size: 24px;
    font-weight: 400;
    line-height: 1;
    padding: 0;
    border: 0;
    background: none;
    color: rgba(23, 20, 18, 0.8);
    text-align: right;
    cursor: pointer;
  }
  .wt-empty {
    padding: 0 18px;
    font-family: ui-serif, 'New York', Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 500;
    color: rgba(23, 20, 18, 0.56);
  }
  .wt-empty:not(:empty) {
    padding-top: 30vh;
    text-align: center;
  }
  .wt-words :global(.wt-word) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 18px;
    position: relative;
  }
  /* The 1px divider is inset 18 on both sides, like WordThru's. */
  .wt-words :global(.wt-word)::after {
    content: '';
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 0;
    height: 1px;
    background: rgba(23, 20, 18, 0.08);
  }
  .wt-words :global(.wt-term) {
    font-family: ui-serif, 'New York', Georgia, 'Times New Roman', serif;
    font-size: 22px;
    font-weight: 500;
  }
  .wt-words :global(.wt-meaning) {
    font-size: 12px;
    line-height: 1.35;
    color: rgba(23, 20, 18, 0.55);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
