---
import Base from '../layouts/Base.astro';

// Unlisted on purpose: nothing links here, and it asks search engines to stay
// away. It is a private writing surface, not a page of the site.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const DRAFT_KEY = import.meta.env.PUBLIC_DRAFT_KEY ?? '';
const configured = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY && DRAFT_KEY);
---

<Base
  title="Draft"
  noindex
  appTitle="Draft"
  standalone
  themeColor="#45539b"
  manifest="/draft.webmanifest"
>
  <div class="draft-page">
    <div class="draft-shell">
      {configured ? (
        <>
          <div class="draft-tabs" role="tablist">
            <button type="button" class="draft-tab" role="tab" data-tab="draft">Draft</button>
            <button type="button" class="draft-tab" role="tab" data-tab="vocab">Vocab</button>
          </div>

          <div class="draft-pane" data-pane="draft">
          <textarea
            class="draft-input"
            data-input
            placeholder="observations, ideas, thoughts"
            autocapitalize="sentences"
            autocorrect="on"
            spellcheck="true"
          ></textarea>

          <div class="draft-bar">
            <button type="button" class="draft-btn draft-btn-quiet" data-send="draft">
              Save as draft
            </button>
            <button type="button" class="draft-btn" data-send="publish">Publish</button>
          </div>

          <span class="draft-status" data-status role="status" aria-live="polite"></span>
          </div>

          {/* Adds to the /vocab list. The passphrase is typed once and kept on
              this device; add_vocab() in Supabase checks it (supabase/vocab.sql). */}
          <div class="draft-pane" data-pane="vocab" hidden>
            <form class="draft-pane" data-vocab-add hidden>
              <input class="draft-field" name="term" placeholder="word" autocapitalize="off" autocomplete="off" required maxlength="80" />
              <textarea class="draft-field draft-field-tall" name="meaning" placeholder="meaning (optional)" maxlength="500"></textarea>
              <button type="submit" class="draft-btn">Add word</button>
            </form>
            <form class="draft-pane" data-vocab-unlock hidden>
              <input class="draft-field" name="passphrase" type="password" placeholder="vocab passphrase" autocomplete="current-password" required />
              <button type="submit" class="draft-btn">Unlock</button>
            </form>
            <span class="draft-status" data-vocab-status role="status" aria-live="polite"></span>
            <a class="draft-link" href="/vocab" target="_blank" rel="noopener">See the list ↗</a>
          </div>
        </>
      ) : (
        <p class="draft-unconfigured">
          Not configured. Set PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY and
          PUBLIC_DRAFT_KEY, and run supabase/drafts.sql.
        </p>
      )}
    </div>
  </div>

  <script
    is:inline
    define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, DRAFT_KEY, configured }}
  >
    if (configured) {
      const input = document.querySelector('[data-input]');
      const buttons = Array.from(document.querySelectorAll('[data-send]'));
      const status = document.querySelector('[data-status]');
      const STASH = 'draft-in-progress';

      // Keep what you typed on the device until it is safely sent, so closing
      // the tab or losing signal mid-thought never costs the note.
      input.value = localStorage.getItem(STASH) ?? '';
      input.addEventListener('input', () => {
        localStorage.setItem(STASH, input.value);
        status.textContent = '';
      });

      async function send(publish) {
        const body = input.value.trim();
        if (!body) return;

        buttons.forEach((b) => (b.disabled = true));
        status.textContent = publish ? 'Publishing…' : 'Saving…';

        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/drafts`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_ANON_KEY,
              authorization: `Bearer ${SUPABASE_ANON_KEY}`,
              'content-type': 'application/json',
              prefer: 'return=minimal',
            },
            body: JSON.stringify({ body, key: DRAFT_KEY, publish }),
          });
          if (!response.ok) throw new Error(String(response.status));

          input.value = '';
          localStorage.removeItem(STASH);
          status.textContent = publish
            ? 'Publishing — it goes live next time your Mac is on.'
            : 'Saved as a draft — it will be waiting in Obsidian.';
        } catch {
          // The text is still stashed locally, so nothing is lost.
          status.textContent = 'Could not send. Your text is kept here — try again.';
        } finally {
          buttons.forEach((b) => (b.disabled = false));
        }
      }

      for (const button of buttons) {
        button.addEventListener('click', () => send(button.dataset.send === 'publish'));
      }
      input.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') send(false);
      });

      // --- Draft | Vocab switch, remembered on this device ---
      const TAB = 'draft-tab';
      const tabs = Array.from(document.querySelectorAll('[data-tab]'));
      function store(key, value) {
        try {
          if (value) localStorage.setItem(key, value);
          else localStorage.removeItem(key);
        } catch (e) {
          console.error('localStorage write failed', e);
        }
      }
      function showTab(name) {
        for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.tab === name));
        for (const pane of document.querySelectorAll('[data-pane]')) pane.hidden = pane.dataset.pane !== name;
        store(TAB, name);
      }
      for (const tab of tabs) tab.addEventListener('click', () => showTab(tab.dataset.tab));
      showTab(localStorage.getItem(TAB) === 'vocab' ? 'vocab' : 'draft');

      // --- Add a vocab word ---
      const PASS = 'vocab-passphrase';
      const addForm = document.querySelector('[data-vocab-add]');
      const unlockForm = document.querySelector('[data-vocab-unlock]');
      const vocabStatus = document.querySelector('[data-vocab-status]');
      const rpc = (name, args) =>
        fetch(`${SUPABASE_URL}/rest/v1/rpc/${name}`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_ANON_KEY,
            authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            'content-type': 'application/json',
          },
          body: JSON.stringify(args),
        });
      function showUnlocked(unlocked) {
        addForm.hidden = !unlocked;
        unlockForm.hidden = unlocked;
      }
      showUnlocked(Boolean(localStorage.getItem(PASS)));

      unlockForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const passphrase = unlockForm.passphrase.value.trim();
        vocabStatus.textContent = 'Checking…';
        try {
          const res = await rpc('vocab_passphrase_ok', { passphrase });
          if (!res.ok) throw new Error(`HTTP ${res.status}: ${await res.text()}`);
          if ((await res.json()) !== true) {
            vocabStatus.textContent = 'Wrong passphrase.';
            return;
          }
          store(PASS, passphrase);
          unlockForm.reset();
          showUnlocked(true);
          vocabStatus.textContent = 'Unlocked on this device.';
        } catch (e) {
          console.error('Passphrase check failed', e);
          vocabStatus.textContent = 'Couldn’t check that. Try again in a minute.';
        }
      });

      addForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const term = addForm.term.value.trim();
        const meaning = addForm.meaning.value.trim();
        if (!term) return;
        const button = addForm.querySelector('button');
        button.disabled = true;
        vocabStatus.textContent = 'Adding…';
        try {
          const res = await rpc('add_vocab', { term, meaning, passphrase: localStorage.getItem(PASS) || '' });
          if (!res.ok) {
            const body = await res.text();
            if (body.includes('bad passphrase')) {
              store(PASS, '');
              showUnlocked(false);
              vocabStatus.textContent = 'Passphrase no longer works. Unlock again.';
              return;
            }
            throw new Error(`HTTP ${res.status}: ${body}`);
          }
          if ((await res.json()) === 'duplicate') {
            vocabStatus.textContent = `“${term}” is already on the list.`;
            return;
          }
          addForm.reset();
          vocabStatus.textContent = `Added “${term}”.`;
          addForm.term.focus();
        } catch (e) {
          console.error('Adding word failed', e);
          vocabStatus.textContent = 'Couldn’t add that. Your text is still here, try again.';
        } finally {
          button.disabled = false;
        }
      });
    }
  </script>
</Base>
