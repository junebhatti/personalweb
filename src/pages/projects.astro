---
import Base from '../layouts/Base.astro';

interface Project {
  title: string;
  description: string;
  /** Optional — a title without one renders as plain text in the same style. */
  href?: string;
}

/** Things in progress or just ideas right now — no year, they aren't done. */
const current: Project[] = [];

/** Finished work, grouped under one year heading per group. */
const years: { year: string; projects: Project[] }[] = [
  {
    year: '2026',
    projects: [
      {
        title: 'Personal Dashboard',
        description:
          'Built a website and mobile app that encompasses all my personal data — tasks, calendars, health data, food tracking, project managing, notes, flashcards, etc.',
      },
      {
        title: 'PodNotes',
        description:
          'A personal app that pulls the currently playing Spotify podcast and acts as a centralized location for taking notes on podcasts.',
      },
      {
        title: 'This website',
        description: 'A portfolio for writing and interests.',
        href: 'https://junaidrbhatti.com',
      },
    ],
  },
];
---

<Base title="Projects — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/" class="back-link">&larr; back</a>
    </div>

    <div class="content">
      <div class="section-label section-label-lg">Things I've built</div>

      <div class="project-groups">
        <div class="project-group">
          <div class="project-year">current</div>
          {current.length > 0 && (
            <div class="entries project-entries">
              {current.map((project) => (
                <div class="entry">
                  {project.href ? (
                    <a href={project.href} target="_blank" rel="noopener" class="entry-title">
                      {project.title}
                    </a>
                  ) : (
                    <span class="entry-title entry-title-plain">{project.title}</span>
                  )}
                  <div class="entry-desc">{project.description}</div>
                </div>
              ))}
            </div>
          )}
        </div>

        {years.map((group) => (
          <div class="project-group">
            <div class="project-year">{group.year}</div>
            <div class="entries project-entries">
              {group.projects.map((project) => (
                <div class="entry">
                  {project.href ? (
                    <a href={project.href} target="_blank" rel="noopener" class="entry-title">
                      {project.title}
                    </a>
                  ) : (
                    <span class="entry-title entry-title-plain">{project.title}</span>
                  )}
                  <div class="entry-desc">{project.description}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
