---
import Base from '../layouts/Base.astro';

interface Project {
  title: string;
  description: string;
  /** Optional — shown as a "Link ↗" under the description. */
  href?: string;
  /** Optional — link this part of the title (or all of it) instead of adding a link row. */
  linkText?: string;
  /** Optional — text for the link row in place of "Link ↗". */
  linkLabel?: string;
  /** YYYY-MM-DD when it shipped. Leave out for things still in progress. */
  date?: string;
}

/** Splits a title around its linkText, failing the build if it isn't in the title. */
function splitTitle(project: Project): [string, string] {
  const i = project.title.indexOf(project.linkText!);
  if (i === -1) {
    throw new Error(`linkText "${project.linkText}" not found in title "${project.title}"`);
  }
  return [project.title.slice(0, i), project.title.slice(i + project.linkText!.length)];
}

/** "2026-10-19" → "10/19/26", failing the build on anything else. */
function formatDate(date: string): string {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
  if (!match) throw new Error(`Project date "${date}" isn't YYYY-MM-DD`);
  const [, year, month, day] = match;
  return `${month}/${day}/${year.slice(2)}`;
}

/** In-progress work first (shown as "current"), then finished work newest first. */
const projects: Project[] = [
  {
    title: 'Growth & Strategy at Novig',
    description:
      'Interning on the growth team at Novig during the fall semester; vibe coding, learning, building.',
    href: 'https://novig.com',
    linkText: 'Novig',
  },
  {
    title: 'This website',
    description: 'A portfolio for writing and interests.',
    href: 'https://junaidrbhatti.com',
    linkText: 'This website',
  },
  {
    title: 'Personal Newsletter',
    description:
      "I got sick of subscribing, getting spammed, and parsing 5-10 newsletters, so I built my own that builds my taste over time and directs me to some people/ideas I'm interested in currently.",
    href: '/brief',
    linkLabel: 'Read today’s here',
  },
  {
    title: 'NYC Turnover',
    date: '2026-10-19',
    description:
      'I love food. I also got curious about NYC restaurants, cafés, and bars as an asset class – which spots last, which flip constantly, and what the rent has to do with it. So I built an interactive atlas where you can trace each storefront’s lifecycle.',
    href: 'https://half-life-nyc.vercel.app',
    linkText: 'NYC Turnover',
  },
  {
    title: 'Personal Dashboard',
    date: '2026-07-15',
    description:
      'Built a website and mobile app that encompasses all my personal data — tasks, calendars, health data, food tracking, project managing, notes, flashcards, etc.',
  },
  {
    title: 'PodNotes',
    date: '2026-04-21',
    description:
      'A personal app that pulls the currently playing Spotify podcast and acts as a centralized location for taking notes on podcasts.',
  },
];
---

<Base title="Projects — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/" class="back-link">&larr; back</a>
    </div>

    <div class="content">
      <div class="section-label">Things I've built</div>

      <div class="project-list">
        {projects.map((project) => (
          <div class="project">
            <div class="project-head">
              <span class="project-title">
                {project.linkText ? (
                  <>
                    {splitTitle(project)[0]}
                    <a href={project.href} target="_blank" rel="noopener">{project.linkText}</a>
                    {splitTitle(project)[1]}
                  </>
                ) : (
                  project.title
                )}
              </span>
              <span class="project-date">{project.date ? formatDate(project.date) : 'current'}</span>
            </div>
            <div class="project-desc">{project.description}</div>
            {project.href && !project.linkText && (
              <div class="project-links">
                <a href={project.href} target="_blank" rel="noopener">{project.linkLabel ?? 'Link ↗'}</a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
