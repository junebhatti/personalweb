---
import Base from '../layouts/Base.astro';

interface Item {
  name: string;
  /** Titles of works are italicised; people, bands and places are not. */
  italic?: boolean;
  note?: string;
}

interface Group {
  label?: string;
  aside?: string;
  items: Item[];
}

interface Section {
  label: string;
  groups: Group[];
}

// Carried over from the old site, wording intact.
const sections: Section[] = [
  {
    label: 'Books',
    groups: [
      {
        items: [
          {
            name: 'Moby Dick',
            italic: true,
            note: "by Herman Melville — the most profound novel I've ever read, discussed it in an English class and fell in love. Billy Budd is also fantastic",
          },
          {
            name: 'The Red Badge of Courage',
            italic: true,
            note: 'by Stephen Crane — my favorite war book',
          },
          {
            name: 'Walden',
            italic: true,
            note: 'by Henry David Thoreau — everyone who cares about nature and craves ways to get away from society should read this',
          },
          {
            name: 'The Royal Game',
            italic: true,
            note: 'by Stefan Zweig — an epic novella about chess, showcasing the power of the mind',
          },
        ],
      },
    ],
  },
  {
    label: 'Podcasts',
    groups: [
      {
        items: [
          {
            name: 'Lex Fridman',
            note: "— has some of the world's greatest thinkers on here, have really fallen in love with these recently",
          },
          {
            name: 'The 7',
            italic: true,
            note: 'by the Washington Post — I start my day with seven headlines from around the world',
          },
          {
            name: 'Hidden Voices',
            note: '— a handful of these have been pretty insightful',
          },
        ],
      },
    ],
  },
  {
    label: 'Movies & Shows',
    groups: [
      {
        label: 'Movies',
        aside: 'I feel strongly about these…. @junaidb on letterboxd',
        items: [
          { name: 'City of God', italic: true, note: '— no words, just perfection' },
          { name: 'Good Will Hunting', italic: true, note: '— insane debut' },
          { name: 'The Motorcycle Diaries', italic: true },
          {
            name: 'The Departed',
            italic: true,
            note: '— ending scene + song make this a 10/10',
          },
          { name: 'Fantastic Mr. Fox', italic: true, note: "— be who you're meant to be" },
          { name: 'Casablanca', italic: true },
          { name: 'Miracle', italic: true, note: '— greatest sports movie imo' },
        ],
      },
      {
        label: 'Shows',
        items: [
          {
            name: 'True Detective',
            italic: true,
            note: '(Season 1) — solidified my number #1 favorite actor as Matthew McConaughey',
          },
          {
            name: 'Cowboy Bebop',
            italic: true,
            note: '— character writing, soundtrack, and animation are peak',
          },
          { name: 'Atlanta', italic: true, note: '— Donald Glover, the GOAT' },
          { name: 'Bojack Horseman', italic: true, note: '— soft spot in my heart' },
        ],
      },
    ],
  },
  {
    label: 'Music',
    groups: [
      {
        items: [
          { name: 'The Strokes', note: '— or anything Julian Casablancas' },
          { name: 'Blue Coupe', italic: true, note: '— Twin Peaks' },
          { name: 'Flimsier', italic: true, note: '— King Krule' },
          { name: 'Us and Them', italic: true, note: '— Pink Floyd' },
          { name: 'Song on the Beach', italic: true, note: '— Arcade Fire' },
          { name: 'Shake the Frost', italic: true, note: '(Live) — Tyler Childers' },
        ],
      },
    ],
  },
  {
    label: 'Restaurants',
    groups: [
      {
        label: 'Los Angeles',
        items: [
          { name: 'Holbox', note: '— fish tacos' },
          { name: 'Sun Nong Dan', note: '— korean' },
          { name: 'Urth Cafe', note: '— european vibe' },
          { name: 'Berenjak', note: '— persian' },
        ],
      },
      {
        label: 'New York City',
        items: [
          { name: 'Los Mariscos', note: '— fish tacos' },
          { name: 'Pause Cafe', note: '— moroccan cafe' },
          { name: "Jonny's Pizza", note: '— speaks for itself' },
          { name: 'Mojo East', note: '— omakase' },
          { name: 'Cafe Mogador', note: '— moroccan / middle eastern' },
        ],
      },
    ],
  },
  {
    label: 'Blogs, videos, channels',
    groups: [{ items: [{ name: 'Keith D' }] }],
  },
];
---

<Base title="Favorites — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/other" class="back-link">&larr; back</a>
    </div>

    <div class="list-content">
      <div class="section-label">Some of my favorite media I've consumed</div>

      {sections.map((section) => (
        <div class="list-section">
          <div class="subhead">{section.label}</div>
          {section.groups.map((group) => (
            <div class="list-group">
              {group.label && <div class="group-label">{group.label}</div>}
              {group.aside && <div class="group-aside">{group.aside}</div>}
              <div class="list-items">
                {group.items.map((item) => (
                  <div>
                    <span class={item.italic ? 'item-name italic' : 'item-name'}>
                      {item.name}
                    </span>
                    {item.note && <> {item.note}</>}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</Base>
