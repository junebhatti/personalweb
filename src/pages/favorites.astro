---
import Base from '../layouts/Base.astro';
import { categories } from '../data/favorites';
---

<Base title="Favorites — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/other" class="back-link">&larr; back</a>
    </div>

    <div class="list-content">
      <div class="section-label">Some of my favorite media I've consumed</div>

      <div class="switch" data-switch hidden>
        {categories.map((category, i) => (
          <>
            {i > 0 && <span class="switch-slash">/</span>}
            <button
              type="button"
              class={i === 0 ? 'switch-option is-on' : 'switch-option'}
              data-category={category.key}
            >{category.label}</button>
          </>
        ))}
      </div>

      {categories.map((category) => (
        <div class="list-section" data-panel={category.key}>
          <div class="subhead" data-panel-head>{category.label}</div>
          {category.groups.map((group) => (
            <div class="list-group">
              {group.label && <div class="group-label">{group.label}</div>}
              {group.aside && <div class="group-aside">{group.aside}</div>}
              <dl class="fav-list">
                {group.entries.map((entry) => (
                  <div class="fav-entry">
                    <dt>
                      <span class="fav-title">{entry.title}</span>
                      {(entry.by || entry.when) && (
                        <span class="fav-by">
                          {[entry.by, entry.when].filter(Boolean).join(' · ')}
                        </span>
                      )}
                    </dt>
                    <dd>{entry.note}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    // Every category is in the page already; this only picks which one shows.
    // Without JavaScript they all render, each under its own heading.
    (function () {
      const bar = document.querySelector('[data-switch]');
      if (!bar) return;
      const panels = Array.from(document.querySelectorAll('[data-panel]'));

      function show(key) {
        for (const panel of panels) {
          panel.hidden = panel.dataset.panel !== key;
          panel.querySelector('[data-panel-head]').hidden = true;
        }
        bar.querySelectorAll('[data-category]').forEach(function (el) {
          el.classList.toggle('is-on', el.dataset.category === key);
        });
        history.replaceState(null, '', '#' + key);
      }

      bar.hidden = false;
      bar.addEventListener('click', function (event) {
        const button = event.target.closest('[data-category]');
        if (button) show(button.dataset.category);
      });

      const wanted = location.hash.slice(1);
      show(panels.some((p) => p.dataset.panel === wanted) ? wanted : panels[0].dataset.panel);
    })();
  </script>
</Base>
