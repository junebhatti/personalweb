---
import Base from '../../layouts/Base.astro';
import { laterItems, briefDate } from '../../lib/briefs';

// Grouped by kind, in the order the brief suggests them most; each group newest first.
const order = ['X account', 'Video', 'Tool', 'App', 'Repo', 'Channel'];
const groups = order
  .map((kind) => ({
    kind,
    items: laterItems.filter((i) => i.kind.toLowerCase() === kind.toLowerCase()),
  }))
  .filter((g) => g.items.length);
---

<Base title="Look into later — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/brief" class="back-link">&larr; today&rsquo;s brief</a>
    </div>
    <div class="list-content">
      <p class="brief-about">
        Everything the Morning Brief has suggested following, trying, or installing, in one place.
      </p>
      {groups.length === 0 && <p class="brief-empty">Nothing yet.</p>}
      {groups.map((g) => (
        <section class="later-group">
          <div class="section-label">{g.kind === 'X account' ? 'X accounts' : g.kind + 's'}</div>
          <ul class="later-list">
            {g.items.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener" class="later-name" set:html={item.name} />
                <span class="later-reason" set:html={item.reason} />
                <a href={`/brief/${item.date}`} class="later-date">{briefDate(item.date)}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
