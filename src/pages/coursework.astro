---
import Base from '../layouts/Base.astro';
import {
  courses,
  DIMENSIONS,
  SCORE_MAX,
  total,
  formatTotal,
  type Course,
} from '../data/coursework';

const weightLabel = (weight: number) =>
  weight === 1 ? 'full' : weight === 0.5 ? 'half' : `×${weight}`;

const fullWeighted = DIMENSIONS.filter((d) => d.weight === 1);
const partWeighted = DIMENSIONS.filter((d) => d.weight !== 1);

const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven'];
const count = (n: number) => WORDS[n] ?? String(n);
const listNames = (items: readonly { label: string }[]) => {
  const names = items.map((d) => d.label.toLowerCase());
  return names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];
};

const GROUPS = [
  { key: 'important', label: 'Important', match: (c: Course) => c.important },
  { key: 'loved', label: 'Loved', match: (c: Course) => c.loved && !c.important },
  { key: 'other', label: 'Other', match: (c: Course) => !c.important && !c.loved },
];

const byScore = [...courses].sort((a, b) => total(b.scores) - total(a.scores));
---

<Base title="Coursework — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/other" class="back-link">&larr; back</a>
    </div>

    <div class="list-content">
      <div class="section-label">Coursework</div>

      <div class="scoring">
        <p class="scoring-lead">
          Every course is scored 0 to 1 on the {DIMENSIONS.length} things below, and the
          number in front of it is their weighted average out of {SCORE_MAX}. Nothing
          counts against a course: on all {DIMENSIONS.length}, more is better. Not all of
          them count the same, though. {count(fullWeighted.length).replace(/^./, (c) => c.toUpperCase())}
          {' '}of them — <span class="scoring-caps">{listNames(fullWeighted)}</span> — count
          full, because they decide whether a class was any good and whether it stayed with
          me. The other {count(partWeighted.length)} —
          {' '}<span class="scoring-caps">{listNames(partWeighted)}</span> — count half.
          They sharpen the judgement without being able to carry a course on their own.
        </p>

        <dl class="scoring-list">
          {DIMENSIONS.map((d) => (
            <div class="scoring-item">
              <dt>
                {d.label} <span class="scoring-weight">{weightLabel(d.weight)}</span>
              </dt>
              <dd>{d.definition}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="sort-toggle" data-sort-toggle hidden>
        <button type="button" class="sort-option is-on" data-sort="section">by section</button>
        <span class="sort-slash">/</span>
        <button type="button" class="sort-option" data-sort="score">by score</button>
      </div>

      <div data-view="section">
        {GROUPS.map((group) => {
          const inGroup = courses.filter(group.match);
          if (!inGroup.length) return null;
          return (
            <div class="list-section">
              <div class="subhead">{group.label}</div>
              <div class="list-items">
                {inGroup.map((course) => (
                  <div class="course-line">
                    <span class="course-score">({formatTotal(total(course.scores))})</span>{' '}
                    <span class="item-name">{course.name}</span> — {course.comment}
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <div data-view="score" hidden>
        <div class="list-items">
          {byScore.map((course) => (
            <div class="course-line">
              <span class="course-score">({formatTotal(total(course.scores))})</span>{' '}
              <span class="item-name">{course.name}</span> — {course.comment}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Both orderings are already in the page; this only swaps which one shows.
    (function () {
      const toggle = document.querySelector('[data-sort-toggle]');
      const views = {
        section: document.querySelector('[data-view="section"]'),
        score: document.querySelector('[data-view="score"]'),
      };
      if (!toggle) return;
      toggle.hidden = false;

      toggle.addEventListener('click', function (event) {
        const button = event.target.closest('[data-sort]');
        if (!button) return;
        const choice = button.dataset.sort;
        views.section.hidden = choice !== 'section';
        views.score.hidden = choice !== 'score';
        toggle.querySelectorAll('[data-sort]').forEach(function (el) {
          el.classList.toggle('is-on', el === button);
        });
      });
    })();
  </script>
</Base>
