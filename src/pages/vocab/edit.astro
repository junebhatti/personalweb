---
import Base from '../../layouts/Base.astro';
import VocabList from '../../components/VocabList.astro';

// Unlisted editor for the word list: nothing links here except the Draft
// app's "Edit list", and it asks search engines to stay away. Changes need the
// passphrase, checked in Supabase (supabase/vocab.sql, vocab-edit.sql).
---

<Base title="Edit vocab" noindex>
  <div class="page vocab-edit-page">
    <div class="back-row">
      <a href="/draft" class="back-link">&larr; back</a>
    </div>
    <div class="content">
      <VocabList editable />
    </div>
  </div>
</Base>

<style>
  /* Opened inside the Draft home-screen app, the page draws under the status bar. */
  @media (display-mode: standalone) {
    .vocab-edit-page {
      padding-top: max(44px, env(safe-area-inset-top));
    }
  }
</style>
