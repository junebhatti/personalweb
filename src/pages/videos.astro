---
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/dates';

// Add a video by dropping in its YouTube id; the thumbnail follows from it.
const videos = [
  {
    id: 'mv1c93CzcGI',
    title: 'choosing peace and abusing black coffee',
    date: new Date('2026-07-08'),
  },
];
---

<Base title="Videos — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/" class="back-link">&larr; back</a>
    </div>

    <div class="content">
      <div class="section-label">YouTube</div>

      <div class="entries">
        {videos.map((video) => (
          <div class="entry video-entry">
            <a
              href={`https://www.youtube.com/watch?v=${video.id}`}
              target="_blank"
              rel="noopener"
              class="video-thumb"
            >
              <img
                src={`https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`}
                alt={`Thumbnail for ${video.title}`}
                width="1280"
                height="720"
                loading="lazy"
              />
            </a>
            <div class="entry-date">{formatDate(video.date)}</div>
            <a
              href={`https://www.youtube.com/watch?v=${video.id}`}
              target="_blank"
              rel="noopener"
              class="entry-title"
            >{video.title}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
