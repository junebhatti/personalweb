---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/dates';

// Newest day first; within a day, most recently written first. `order` carries
// the time of day — the date field only has the day, so without it same-day
// notes would sort by slug.
const all = await getCollection('notes');
const rank = (n: (typeof all)[number]) => n.data.order ?? n.data.date.valueOf();
const notes = all.sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    rank(b) - rank(a) ||
    a.id.localeCompare(b.id)
);

// Group by date, newest first. Notes are short enough to sit on the index in
// full, so each card renders the note itself — through the same markdown
// pipeline as its own page, or the index would show the asterisks around an
// italic rather than the italic.
type Card = { id: string; time?: string; Content: Awaited<ReturnType<typeof render>>['Content'] };
const groups: { date: Date; notes: Card[] }[] = [];
for (const note of notes) {
  const key = note.data.date.valueOf();
  const { Content } = await render(note);
  const card = { id: note.id, time: note.data.time, Content };
  const group = groups.find((g) => g.date.valueOf() === key);
  if (group) {
    group.notes.push(card);
  } else {
    groups.push({ date: note.data.date, notes: [card] });
  }
}
---

<Base title="Notes — Junaid Bhatti">
  <div class="page">
    <div class="back-row">
      <a href="/" class="back-link">&larr; back</a>
    </div>

    <div class="content">
      <div class="section-label">Short form — thoughts, ideas, observations</div>

      <div class="note-groups">
        {groups.map((group) => (
          <div class="note-group">
            <div class="note-group-date">{formatDate(group.date)}</div>
            <div class="note-list">
              {group.notes.map((note) => (
                <a href={`/notes/${note.id}`} class="note-card">
                  {note.time && <div class="note-time">{note.time}</div>}
                  <div class="note-card-body"><note.Content /></div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
