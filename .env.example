# Phone drafting. Copy to .env and fill in from Supabase → Project Settings → API.

# Safe in the browser — the drafts table only allows INSERT with the key below.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# A long random string of your choosing. Must match the value in
# supabase/drafts.sql, which is what stops strangers posting into your vault.
PUBLIC_DRAFT_KEY=change-me-to-something-long-and-random

# Server-side only. Bypasses row-level security, so it must never appear in a
# PUBLIC_ variable or reach the browser. Used only by scripts/pull-drafts.mjs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
